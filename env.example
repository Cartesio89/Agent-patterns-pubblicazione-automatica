# Copia questo file in ".env" (NON committare .env) e compila.
ANTHROPIC_API_KEY=
# Opzionale: se non impostato usa il modello predefinito del codice (da verificare sul tuo account)
# ANTHROPIC_MODEL=
# Se l'API rifiuta il parametro temperature per il tuo modello:
# LLM_TEMPERATURE=none

# Feed RSS/Atom separati da virgola (Reddit: aggiungi .rss all'indirizzo del subreddit)
FEEDS=

# Cadenza minima in giorni tra due esecuzioni riuscite (modalità smart)
# CADENCE_NEWS_SCOUT=1
# CADENCE_INSTAGRAM_DRAFT=2
# CADENCE_NEWSLETTER_DRAFT=7

# Opzionale: cartella skills/ del pacchetto Instagram italiano (humanize.py e caption.py)
# IG_PACK_PATH=C:\percorso\Automazione-pubblicazione-post\skills

# Opzionale: dove salvare memoria, log e report (default: ./data)
# AGENTS_DATA_DIR=
